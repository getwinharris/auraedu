cmd_lint() {
  require_php
  local target="${1:-}"
  if [ -n "$target" ]; then
    if [ -f "$target" ]; then
      php -l "$target"
    else
      find "$target" -name '*.php' -exec php -l {} \; 2>&1 | grep -v 'No syntax errors' || true
